---
/**
 * Viewer page shell: meta tags and the control panel. The WebGPU app is started by the
 * bundled module script below; the page mode is handed over through data-* attributes.
 */
import { readFileSync } from 'node:fs';
import 'maplibre-gl/dist/maplibre-gl.css';
import { WAVES_SLUG, parseAreaList } from '../data/area';
import '../style.css';

export type Props = {
  /** document title and og:title */
  title: string;
  description: string;
  /** path of this page, e.g. '/' or '/nagoya/' */
  path: string;
  /** subtitle next to the heading */
  areaName: string;
  /**
   * 'station': Tokyo Station LOD2 (single bake); 'waves': the same scene with the height waves
   * cut into the distance field; 'area': streamed LOD1 tiles of `slug`
   */
  mode: 'station' | 'waves' | 'area';
  slug?: string;
};

const { title, description, path, areaName, mode, slug = '' } = Astro.props;
const readAreaList = () => {
  try {
    return readFileSync('public/data/areas.json', 'utf8');
  } catch {
    return null;
  }
};
const areas = parseAreaList(readAreaList());
const ogUrl = new URL(path, Astro.site).href;
const ogImage = new URL('/ogp.jpg', Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-mode={mode} data-slug={slug}>
    <div id="map"></div>
    <button id="panel-show" type="button" title="パネルを表示" aria-label="パネルを表示">☰</button>
    <aside id="panel">
      <header>
        <h1>SDF PLATEAU <small>{areaName}</small></h1>
        <button id="panel-hide" type="button" title="パネルを隠す" aria-label="パネルを隠す">×</button>
      </header>
      {areas.length > 0 && (
        <label>地域
          <select id="area">
            <option value="" selected={mode === 'station'}>東京駅周辺（LOD2）</option>
            <option value={WAVES_SLUG} selected={mode === 'waves'}>東京駅周辺（波を SDF に合成）</option>
            {areas.map((a) => <option value={a.slug} selected={a.slug === slug}>{a.name}（LOD1）</option>)}
          </select>
        </label>
      )}
      {mode !== 'area' && (
        <label>描画
          <select id="mode">
            <option value="sdf">SDF レイマーチ</option>
            <option value="raster">ラスタ（比較用）</option>
          </select>
        </label>
      )}
      <label>色分け
        <select id="color">
          <option value="0">面の種類</option>
          <option value="1">高さ</option>
          <option value="2">用途</option>
          <option value="3">建築年</option>
          <option value="5">高さの波</option>
          <option value="4">ステップ数（デバッグ）</option>
        </select>
      </label>
      <label>日付 <input id="date" type="date" /></label>
      <label class="row">時刻 <input id="time" type="range" min="0" max="1439" step="1" /> <span id="time-label"></span>
        <button id="play" type="button">▶</button></label>
      <fieldset>
        <label class="check"><input id="shadows" type="checkbox" /> 影（ソフトシャドウ）</label>
        <label class="check"><input id="groundShadows" type="checkbox" /> 地面の影</label>
        <label class="check"><input id="ao" type="checkbox" /> アンビエントオクルージョン</label>
        {mode === 'station' && <label class="check"><input id="refine" type="checkbox" /> 交点を三角形で補正</label>}
        <label class="check"><input id="picking" type="checkbox" /> クリックで建物を選択</label>
      </fieldset>
      <label class="row">解像度 <input id="scale" type="range" min="0.25" max="1" step="0.05" /> <span id="scale-label"></span></label>
      <label>背景地図
        <select id="base">
          <option value="pale">淡色地図</option>
          <option value="std">標準地図</option>
          <option value="photo">航空写真</option>
          <option value="white">白（地図なし）</option>
        </select>
      </label>
      <p id="fps"></p>
      <p id="status"></p>
    </aside>
    <script>
      import '../main';
    </script>
  </body>
</html>
