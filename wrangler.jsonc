{
  // Cloudflare Workers (static assets only): serves the Vite build output in ./dist.
  // Deployed by Workers Builds on every push to GitHub (build: `pnpm build`, deploy: `npx wrangler deploy`).
  // The Worker name in the Cloudflare dashboard must match "name" below.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sdf-plateau",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
